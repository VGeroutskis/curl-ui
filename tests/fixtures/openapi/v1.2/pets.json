{"swaggerVersion":"1.2","basePath":"https://api.example.com/v1","resourcePath":"/pets",
 "produces":["application/json"],
 "apis":[
  {"path":"/pets","operations":[
    {"method":"GET","nickname":"listPets","summary":"List pets","type":"array","items":{"$ref":"Pet"},
     "authorizations":{"key":[]},
     "parameters":[
      {"paramType":"query","name":"limit","type":"integer","required":true,"defaultValue":"10"},
      {"paramType":"query","name":"status","type":"string","enum":["open","closed"]},
      {"paramType":"header","name":"X-Trace","type":"string"}]},
    {"method":"POST","nickname":"createPet","type":"void","authorizations":{"basic":[]},
     "consumes":["application/json"],
     "parameters":[{"paramType":"body","name":"body","type":"Pet","required":true}]}]},
  {"path":"/pets/{petId}.{format}","operations":[
    {"method":"GET","nickname":"getPet","parameters":[{"paramType":"path","name":"petId","type":"string","required":true}],
     "authorizations":{"qkey":[]}}]},
  {"path":"/upload","operations":[
    {"method":"POST","nickname":"upload","consumes":["multipart/form-data"],"authorizations":{"oauth":[]},
     "parameters":[
      {"paramType":"form","name":"title","type":"string"},
      {"paramType":"form","name":"file","type":"File","required":true}]}]}],
 "models":{
  "Pet":{"id":"Pet","properties":{"name":{"type":"string"},"age":{"type":"integer"},"owner":{"$ref":"Owner"},"tags":{"type":"array","items":{"type":"string"}}}},
  "Owner":{"id":"Owner","properties":{"pet":{"$ref":"Pet"}}}}}
